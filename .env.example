# ─── Database ───────────────────────────────────────────────────────────────
# Neon Postgres connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Better Auth ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Set to the deployed domain in production (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth ───────────────────────────────────────────────────────────
# Create at https://console.cloud.google.com/ — add your domain as an
# authorised redirect URI: https://your-domain.com/api/auth/callback/google
GOOGLE_AUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=your-google-client-secret

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Required for password reset emails. Get a key at https://resend.com/
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender address in your Resend account (e.g. noreply@yourdomain.com).
# Defaults to noreply@beehive-studio.app when unset.
RESEND_FROM_EMAIL=Beehive Studio <noreply@yourdomain.com>

# ─── Email verification (optional) ──────────────────────────────────────────
# Set to "true" to require email verification before sign-in. Requires
# RESEND_API_KEY to be configured. Leave unset or "false" for development.
# REQUIRE_EMAIL_VERIFICATION=false

# ─── Rate limiting (Upstash Redis) ──────────────────────────────────────────
# Create a serverless Redis database at https://upstash.com/
# Leave unset in development to skip rate limiting (always-allow fallback).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─── Stripe ─────────────────────────────────────────────────────────────────
# See https://stripe.com/docs/keys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_MONTHLY=price_xxx
STRIPE_PRICE_ID_ANNUAL=price_xxx
# Set to "true" ONLY when going live with real payments. It forces
# STRIPE_SECRET_KEY to be a live key (sk_live_). Leave unset to run in Stripe
# test/sandbox mode (the default), which is what alpha/preview deploys use.
STRIPE_REQUIRE_LIVE=

# ─── Cloudinary (image uploads) ─────────────────────────────────────────────
# Required for cover image and avatar uploads. Create at https://cloudinary.com/
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── App URL ────────────────────────────────────────────────────────────────
# Used by the Stripe checkout success/cancel redirect URLs and the auth client.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Admin panel ────────────────────────────────────────────────────────────
# Credentials are checked against env at /admin/login.
# Generate ADMIN_SESSION_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-something-strong
ADMIN_SESSION_SECRET=replace-with-32-byte-hex

# ─── Dev overrides ──────────────────────────────────────────────────────────
# Set to "true" in .env.local to bypass the Stripe subscription check locally.
# DEV_FORCE_PREMIUM=false
